# Cấu hình cho integration test (ClientModule).
#
# Chép file này thành `.env` cùng thư mục rồi điền giá trị của máy bạn.
# `.env` đã nằm trong .gitignore — TUYỆT ĐỐI không commit, và không đặt giá trị thật vào
# file .example này.

# --- ap-login ---
TEST_AP_LOGIN_URL=http://localhost:8120
# Phải khớp RSA_DELIMITER của ap-login. Xem giá trị đang chạy bằng:
#   docker exec ap-login printenv RSA_DELIMITER
TEST_RSA_DELIMITER=

# --- SmartFox ---
TEST_SFS_HOST=localhost
TEST_SFS_PORT=9933
TEST_SFS_ZONE=BomberGameZone

# --- Postgres (chỉ localhost; test có xoá/ghi bảng log) ---
TEST_PG_URL=jdbc:postgresql://localhost:5432/bombcrypto
TEST_PG_USER=postgres
TEST_PG_PASSWORD=

# --- Redis ---
TEST_REDIS_URL=redis://localhost:6379
