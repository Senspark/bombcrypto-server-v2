# ap-deposit-bridge — cross-chain bridge withdraw SIGNER (Phase 9, stateless)
IS_PROD=false
PORT=8108

# Redis (SmartFox ↔ signer request/response streams).
REDIS_CONNECTION_STRING=redis://@redis:6379/0

# Key holding SIGNER_ROLE on EVERY chain's DepositBridge. Signs EIP-191 off-chain — no gas, no provider,
# no funds held. On testnet the operator/deployer key (0x8CA0…5396) already has SIGNER_ROLE from initialize.
SIGNER_PRIVATE_KEY=0x

# Shared blockchain-center-api gateway — all RPC reads (deposited @ confirmed depth) route through it. Required.
BLOCKCHAIN_CENTER_API=http://localhost:8107

# Operational window: a signed withdraw stays relayable for this many seconds (deadline = now + this).
# Not a safety gate (§4.4) — just bounds the signed→executed|expired lifecycle. Users usually relay at once.
SIGN_WINDOW_SECONDS=900

# Short per-wallet cache TTL (ms) for the source `deposited` read — monotonic-safe, anti-spam against RPC.
DEPOSIT_CACHE_TTL_MS=5000

# ── Indexer/Monitor (report only — off by default; the signer runs fine without it) ──────────────────
INDEXER_ENABLED=false

# DEDICATED report database (own DB, not the SmartFox game DB). Apply db/schema.sql before starting.
INDEXER_DATABASE_URL=postgres://postgres:123456@postgres:5432/bombcrypto_bridge_report

# Bridge DEPLOY block per chain — the floor of the backfill gap. The tail itself always starts at the
# current head on boot; everything from this block up to that head is recorded as a gap to backfill by hand.
INDEXER_START_BLOCK_BSC=0
INDEXER_START_BLOCK_POLYGON=0

# IDLE sweep cadence (ms): the loose safety-net drain between activity, also drives the anomaly check. A
# SmartFox notify wakes the sweeper early, so this can stay long.
INDEXER_SWEEP_INTERVAL_MS=300000

# ACTIVE sweep cadence (ms): after a notify, re-drain this often so a tx landing seconds later is caught fast.
INDEXER_SWEEP_ACTIVE_INTERVAL_MS=3000

# How long (ms) the sweeper stays in ACTIVE mode after the last notify (covers confirmed-depth + MetaMask delay).
INDEXER_SWEEP_ACTIVE_WINDOW_MS=60000

# How often (ms) the withdraw lifecycle watcher polls withdrawn[wallet] for pending signed authorizations.
INDEXER_LIFECYCLE_POLL_MS=15000

# Shared secret for the read-only /monitor REST endpoints (X-Admin-Key). Empty disables the check.
ADMIN_API_KEY=

# Redis TTL (ms) for the slow on-chain monitor snapshots (aggregate/health). The page serves the cached
# snapshot and only re-reads the chain when the operator hits Refresh. Safety expiry only (default 1h; 0 = forever).
MONITOR_CACHE_TTL_MS=3600000
